<?xml version="1.0" encoding="utf-8"?>
<!-- Daily greeting by the fighter on the first app start of a day (fork). The fighter speaks as "I". -->
<resources>
    <string name="greeting_header_welcome">Welcome</string>
    <string name="greeting_header_morning">Good morning</string>
    <string name="greeting_header_day">Hello</string>
    <string name="greeting_header_evening">Good evening</string>
    <!-- %1$s = fighter name -->
    <string name="greeting_welcome_title">Hi, I’m %1$s!</string>
    <string name="greeting_welcome_text">Every routine you finish makes me stronger. Then we fight together in the arena.</string>
    <string name="greeting_first_day_title">Great to have you here!</string>
    <string name="greeting_first_day_text">Check off your first routine today and my training begins.</string>
    <string name="greeting_tired_title">I am a little tired</string>
    <string name="greeting_tired_text">Check off a routine today and I’ll be back on my feet.</string>
    <plurals name="greeting_growing_title">
        <item quantity="one">%1$d day in a row!</item>
        <item quantity="other">%1$d days in a row!</item>
    </plurals>
    <!-- %1$d = active days still missing, %2$d = number of the next rank -->
    <plurals name="greeting_growing_next">
        <item quantity="one">%1$d more active day and I reach rank %2$d.</item>
        <item quantity="other">%1$d more active days and I reach rank %2$d.</item>
    </plurals>
    <string name="greeting_growing_last">I’m a Legend now. Thanks for sticking with it!</string>
    <!-- 💧 is drawn as the water coin -->
    <string name="greeting_water">You have %1$d 💧</string>
    <string name="greeting_start">Let’s go</string>
    <string name="greeting_setting">Daily greeting</string>
    <string name="greeting_setting_desc">Your fighter greets you on the first app start of each day</string>
    <!-- empty routine page -->
    <string name="greeting_empty_title">%1$s is waiting for you</string>
    <string name="greeting_empty_text">Add a routine and %1$s wakes up.</string>
    <string name="greeting_empty_button">Add routine</string>

    <!-- First start setup and the user's name (#139); %1$s = user name -->
    <string name="greeting_header_morning_named">Good morning, %1$s</string>
    <string name="greeting_header_day_named">Hello, %1$s</string>
    <string name="greeting_header_evening_named">Good evening, %1$s</string>
    <!-- %1$s = user name, %2$s = fighter name -->
    <string name="greeting_welcome_title_named">Hi %1$s, I’m %2$s!</string>
    <string name="setup_name_title">What should I call you?</string>
    <!-- %1$s = fighter name -->
    <string name="setup_name_text">Hi, I’m %1$s! Tell me your name and I can greet you in person.</string>
    <string name="setup_name_label">Your name</string>
    <string name="setup_name_hint">Only stored on your phone.</string>
    <string name="setup_name_next">Continue</string>
    <string name="setup_name_skip">Skip</string>
    <string name="user_name_setting">Your name</string>
    <string name="user_name_setting_empty">No name yet, tap to add one</string>
    <string name="user_name_hint">Leave empty to be greeted without a name</string>

    <!-- First start (#16, #26): pick the fighter and its colours, final afterwards -->
    <string name="setup_fighter_title">Who trains with you?</string>
    <string name="setup_fighter_final">Choose carefully: your fighter and its colours stay for good. Later, only a gi from the shop changes the main colour.</string>
    <!-- %1$s = fighter name -->
    <string name="setup_fighter_choose">Train with %1$s</string>
    <string name="setup_fighter_confirm_title">Train with %1$s?</string>
    <string name="setup_fighter_confirm_text">This choice is final. You can’t change the fighter or its colours later.</string>
    <string name="setup_fighter_confirm_yes">Yes, let’s go</string>
    <string name="setup_fighter_confirm_back">Keep looking</string>
</resources>
